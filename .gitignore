# macOS
.DS_Store

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/

# Local environment variables and credentials
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# R workspace files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Editor and temporary files
*.swp
*.swo
*~

# QGIS and GeoPackage temporary files
*.qgz~
*.gpkg-wal
*.gpkg-shm

# Logs and local caches
*.log
.cache/

# Large external routing inputs
*.pbf
*.osm
*.osm.gz
*.zip

# Large generated routing outputs
*ITINERARIES*.csv
*TRAVEL_TIME_MATRIX*.csv
*TIME_MATRIX*.csv

# Reproducible routing work products retained locally
/generated_outputs/routing/matrices/**
!/generated_outputs/routing/matrices/**/
!/generated_outputs/routing/matrices/**/README.md
/generated_outputs/routing/itineraries/*
!/generated_outputs/routing/itineraries/README.md
/generated_outputs/routing/diagnostics/*
!/generated_outputs/routing/diagnostics/README.md
/data/external/local_inputs/*
!/data/external/local_inputs/README.md

# QGIS source layers; retain the portable candidate CSV only
/gis/layers/routing_inputs/source_layers/

# Local routing backups and Python caches
/code/routing/archive/*
!/code/routing/archive/README.md
